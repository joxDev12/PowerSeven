[Unit]
Description=PowerSeven AD Dashboard
Wants=network-online.target
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/azienda-portal
EnvironmentFile=/etc/azienda-portal.env
ExecStart=/usr/bin/gunicorn --workers 1 --bind 127.0.0.1:5000 app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
