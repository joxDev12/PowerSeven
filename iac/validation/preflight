#!/usr/bin/env python3
"""Read-only PowerSeven IaC preflight; never creates or changes resources."""

from __future__ import annotations

import ipaddress
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None


ROOT = Path(__file__).resolve().parents[2]
IAC = ROOT / "iac"
GRAPH = ROOT / "graph" / "powerseven.graph.json"
FAIL = 0
WARN = 0
PASS = 0


def report(level: str, label: str, detail: str) -> None:
    global FAIL, WARN, PASS
    print(f"{level}: {label}: {detail}")
    if level == "FAIL":
        FAIL += 1
    elif level == "WARN":
        WARN += 1
    elif level == "PASS":
        PASS += 1


def load_yaml(path: Path):
    if yaml is None:
        raise RuntimeError("PyYAML unavailable")
    with path.open(encoding="utf-8") as stream:
        return yaml.safe_load(stream)


def walk(value, key=None):
    yield key, value
    if isinstance(value, dict):
        for child_key, child_value in value.items():
            yield from walk(child_value, child_key)
    elif isinstance(value, list):
        for child_value in value:
            yield from walk(child_value, key)


def read_text_files():
    ignored_suffixes = {".html", ".png", ".jpg", ".jpeg", ".webp", ".woff", ".pyc"}
    for path in ROOT.rglob("*"):
        if not path.is_file() or ".git" in path.parts:
            continue
        if path.suffix.lower() in ignored_suffixes:
            continue
        try:
            yield path, path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue


def check_yaml_json():
    if yaml is None:
        report("FAIL", "yaml", "PyYAML is required; install nothing automatically")
    else:
        for path in sorted(IAC.rglob("*.yml")) + sorted(IAC.rglob("*.yaml")):
            try:
                load_yaml(path)
            except Exception as exc:  # syntax errors are the useful result here
                report("FAIL", "yaml", f"{path.relative_to(ROOT)}: {exc}")
        report("PASS", "yaml", "all iac YAML parsed")

    json_files = sorted(ROOT.glob("graph/*.json")) + sorted(ROOT.glob("diagrams/*.json"))
    for path in json_files:
        try:
            with path.open(encoding="utf-8") as stream:
                json.load(stream)
        except Exception as exc:
            report("FAIL", "json", f"{path.relative_to(ROOT)}: {exc}")
    if json_files:
        report("PASS", "json", f"parsed {len(json_files)} JSON files")


def check_graph_references(inventories, graph):
    node_ids = {node.get("id") for node in graph.get("nodes", [])}
    for path, data in inventories:
        for key, value in walk(data):
            if key != "graph_id" or not isinstance(value, str):
                continue
            if value in node_ids:
                continue
            if value.startswith("legacy_"):
                report("WARN", "graph-reference", f"{path.relative_to(ROOT)}: legacy id {value}")
            else:
                report("FAIL", "graph-reference", f"{path.relative_to(ROOT)}: missing node {value}")
    report("PASS", "graph-reference", f"checked {len(node_ids)} graph nodes")


def check_ip_and_cidr(hosts, networks):
    addresses = {}
    for host_id, host in hosts["hosts"].items():
        target_ip = host["target_local"]["underlay_ip"]
        addresses[f"{host_id}.underlay"] = ipaddress.ip_address(target_ip)
        for interface in host.get("interfaces", []):
            if interface.get("network") == "wireguard":
                addresses[f"{host_id}.overlay"] = ipaddress.ip_interface(interface["address"]).ip
    seen = {}
    for label, address in addresses.items():
        if address in seen:
            report("FAIL", "duplicate-ip", f"{label} and {seen[address]} use {address}")
        seen[address] = label
    report("PASS", "duplicate-ip", f"checked {len(addresses)} target host addresses")

    cidrs = {
        "underlay": networks["target_local"]["underlay"]["cidr"],
        "overlay": networks["target_local"]["overlay"]["cidr"],
    }
    for item in networks.get("container_networks", {}).get("networks", []):
        cidrs[f"docker:{item['name']}"] = item["cidr"]
    parsed = {name: ipaddress.ip_network(cidr, strict=False) for name, cidr in cidrs.items()}
    names = list(parsed)
    for index, left_name in enumerate(names):
        for right_name in names[index + 1 :]:
            if parsed[left_name].overlaps(parsed[right_name]):
                report("FAIL", "cidr-overlap", f"{left_name} overlaps {right_name}")
    report("PASS", "cidr-overlap", f"checked {len(parsed)} target networks")


def check_secrets():
    data_pattern = re.compile(
        r"-----BEGIN .*PRIVATE KEY-----|"
        r"(?:password|passwd|(?<![A-Za-z])token|api[_-]?key|private[_-]?key)\s*[:=]\s*"
        r"(?!(?:[\"']?REQUIRED_SECRET|[\"']?REQUIRED_DECISION|[\"']?<|[\"']?\$\{|[\"']?not in repository))"
        r"(?:[\"'][^\"']+[\"']|[^#\s]+)",
        re.IGNORECASE,
    )
    code_pattern = re.compile(
        r"(?:password|passwd|token|api[_-]?key|private[_-]?key)\s*[:=]\s*"
        r"(?P<quote>[\"'])(?!(?:REQUIRED_SECRET|REQUIRED_DECISION|<))[^\"']+?(?P=quote)",
        re.IGNORECASE,
    )
    matches = []
    for path, text in read_text_files():
        if path == Path(__file__):
            continue
        pattern = code_pattern if path.suffix.lower() in {".py", ".ps1", ".sh"} else data_pattern
        for line_number, line in enumerate(text.splitlines(), 1):
            if pattern.search(line):
                matches.append(f"{path.relative_to(ROOT)}:{line_number}")
    if matches:
        report("FAIL", "inline-secret", ", ".join(matches[:8]))
    else:
        report("PASS", "inline-secret", "no private key or inline credential value")


def check_user_provisioning_template():
    path = IAC / "windows" / "users.psd1"
    if not path.is_file():
        report("FAIL", "user-template", "tracked iac/windows/users.psd1 is missing")
        return
    text = path.read_text(encoding="utf-8")
    match = re.search(r"\bUsers\s*=\s*@\((.*?)\)", text, re.DOTALL)
    if match is None:
        report("FAIL", "user-template", "users.psd1 must declare Users = @(...) explicitly")
    elif match.group(1).strip():
        report("FAIL", "user-template", "tracked users.psd1 must contain no installer-specific accounts; use users.local.psd1")
    else:
        report("PASS", "user-template", "tracked users.psd1 contains no installer-specific accounts")


def check_decisions():
    matches = []
    for path, text in read_text_files():
        if path == Path(__file__):
            continue
        if path.suffix.lower() in {".md", ".html"}:
            continue
        if "REQUIRED_DECISION" in text:
            matches.append(str(path.relative_to(ROOT)))
    if matches:
        report("WARN", "required-decision", "open decisions in " + ", ".join(sorted(set(matches))))
    else:
        report("PASS", "required-decision", "none")


def check_dependency_cycles(dependencies):
    graph = {name: set(spec.get("requires", [])) for name, spec in dependencies["roles"].items()}
    visiting, visited = set(), set()

    def visit(node, path):
        if node in visiting:
            report("FAIL", "dependency-cycle", " -> ".join(path + [node]))
            return
        if node in visited:
            return
        visiting.add(node)
        for requirement in graph.get(node, ()):
            if requirement not in graph:
                report("FAIL", "dependency-reference", f"{node} requires missing {requirement}")
            else:
                visit(requirement, path + [node])
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node, [])
    report("PASS", "dependency-cycle", f"checked {len(graph)} roles")


def check_dns(dns):
    records = {record["name"]: record for record in dns["zones"][0]["records"]}
    if records.get("dc02", {}).get("address") != "192.168.214.13":
        report("FAIL", "dns", "dc02 must use underlay 192.168.214.13")
    application_names = {"cloud", "git", "login", "panel", "pdf", "scribble", "scribble-2", "wazuh", "wings", "adguard"}
    for name in application_names:
        record = records.get(name, {})
        if record.get("address") != "10.10.10.14" or record.get("address_plane") != "wireguard_overlay":
            report("FAIL", "dns", f"{name} must use overlay 10.10.10.14")
    report("PASS", "dns", "underlay infrastructure and overlay application records declared")


def check_ports(services):
    service_map = {item.get("graph_id"): item for item in services["services"]}
    expected = {
        "svc_wireguard_hub": "51820/udp",
        "id_dns_dc02": "53/tcp",
        "svc_nginx": "443/tcp",
    }
    for service_id, port in expected.items():
        if port not in service_map.get(service_id, {}).get("ports", []):
            report("FAIL", "expected-port", f"{service_id} missing {port}")
    report("PASS", "expected-port", "critical ports declared")


def check_vm_resources(vms):
    entries = vms["vms"]
    totals = {key: sum(int(vm[key]) for vm in entries) for key in ("vcpu", "memory_gib", "disk_gib")}
    expected = {"vcpu": 8, "memory_gib": 10, "disk_gib": 180}
    if len(entries) != 3 or totals != expected:
        report("FAIL", "vm-resources", f"got {len(entries)} VMs and totals {totals}, expected {expected}")
    else:
        report("PASS", "vm-resources", f"3 VMs; totals {totals}")


def check_vmware_definitions(vms):
    vmware = IAC / "vmware"
    create_vms = vmware / "create-vms"
    validator = vmware / "validate-vms"
    if create_vms.exists():
        report("FAIL", "vmware-safety", "operational create-vms must not exist")
    else:
        report("PASS", "vmware-safety", "no operational VM creation command")
    if validator.is_file() and validator.stat().st_mode & 0o111:
        report("PASS", "vmware-validator", "validate-vms exists and is executable")
    else:
        report("FAIL", "vmware-validator", "read-only validate-vms is missing or not executable")
    generated = sorted(vmware.rglob("*.vmx")) + sorted(vmware.rglob("*.vmdk"))
    if generated:
        report("FAIL", "vmware-artifacts", "generated VM artifacts found: " + ", ".join(str(p.relative_to(ROOT)) for p in generated))
    else:
        report("PASS", "vmware-artifacts", "no VMX/VMDK artifacts in repository")

    entries = vms.get("vms", [])
    ids = [item.get("id") for item in entries]
    names = [item.get("vm_name") for item in entries]
    def underlay_nic(item):
        if item.get("nics"):
            return next((nic for nic in item["nics"] if nic.get("role") == "vmnet8-underlay"), {})
        return item.get("nic", {})

    ips = [str(underlay_nic(item).get("address", underlay_nic(item).get("underlay_ip"))).split("/")[0] for item in entries]
    if len(entries) != 3 or len(set(ids)) != len(ids) or len(set(names)) != len(names) or len(set(ips)) != len(ips):
        report("FAIL", "vmware-definitions", "three unique VM ids, names and underlay IPs are required")
        return
    errors = []
    for item in entries:
        if item.get("state") != "definition_only":
            errors.append(f"{item.get('id')}: state")
        if item.get("nics"):
            underlay = underlay_nic(item)
            if underlay.get("network") != "VMnet8" or underlay.get("address", "").split("/")[0] not in ips:
                errors.append(f"{item.get('id')}: network")
        elif item.get("nic", {}).get("network") != "VMnet8":
            errors.append(f"{item.get('id')}: network")
        if not str(item.get("vmx_path", "")).startswith("<VM_STORAGE_ROOT>/"):
            errors.append(f"{item.get('id')}: vmx_path must be parameterized")
        if item.get("iso_ref") not in vms.get("isos", {}):
            errors.append(f"{item.get('id')}: iso_ref")
    network = vms.get("network", {})
    if network.get("name") != "VMnet8" or network.get("cidr") != "192.168.214.0/24" or network.get("gateway") != "192.168.214.2":
        errors.append("network: VMnet8 target")
    if errors:
        report("FAIL", "vmware-definitions", "; ".join(errors))
    else:
        report("PASS", "vmware-definitions", "manual GUI specification is complete and parameterized")


def contains_azure(value):
    return isinstance(value, str) and "azure" in value.lower()


def check_scope_separation(inventories):
    for path, data in inventories:
        target = data.get("target_local") if isinstance(data, dict) else None
        if target is None:
            continue
        if any(contains_azure(value) for _, value in walk(target)):
            report("FAIL", "scope-separation", f"Azure reference inside target_local: {path.relative_to(ROOT)}")
    report("PASS", "scope-separation", "target_local sections contain no Azure dependency")


def check_compose():
    compose = load_yaml(IAC / "docker" / "compose.yml")
    expected = {"adguard", "nextcloud", "nextcloud-redis", "forgejo", "stirling", "scribble-1", "scribble-2"}
    actual = set(compose.get("services", {}))
    if not expected.issubset(actual):
        report("FAIL", "compose", f"missing services {sorted(expected - actual)}")
    else:
        report("PASS", "compose", f"declared services: {', '.join(sorted(actual))}")


def check_vps14_cp4():
    bootstrap = (IAC / "linux" / "bootstrap.sh").read_text(encoding="utf-8")
    runner = (IAC / "windows" / "setup-powerseven.ps1").read_text(encoding="utf-8")
    compose = load_yaml(IAC / "docker" / "compose.yml")
    docker_versions = next(
        (item for item in load_yaml(IAC / "versions.yml")["versions"] if item["name"] == "Docker Engine"),
        None,
    )
    expected_packages = {
        "docker-ce": "5:29.8.1-1~ubuntu.24.04~noble",
        "docker-ce-cli": "5:29.8.1-1~ubuntu.24.04~noble",
        "containerd.io": "2.3.6-1~ubuntu.24.04~noble",
        "docker-compose-plugin": "5.5.1-1~ubuntu.24.04~noble",
    }
    package_constants = {
        "docker-ce": "DOCKER_CE_VERSION",
        "docker-ce-cli": "DOCKER_CE_VERSION",
        "containerd.io": "CONTAINERD_IO_VERSION",
        "docker-compose-plugin": "DOCKER_COMPOSE_VERSION",
    }
    versions_match = bool(
        docker_versions
        and docker_versions.get("target_version") == "29.8.1"
        and docker_versions.get("package_versions") == expected_packages
        and all(
            re.search(
                rf"^readonly {constant}='{re.escape(expected_packages[package])}'$",
                bootstrap,
                re.MULTILINE,
            )
            for package, constant in package_constants.items()
        )
    )
    if versions_match:
        report("PASS", "cp4-docker-pins", "versions.yml and bootstrap agree on exact Noble package versions")
    else:
        report("FAIL", "cp4-docker-pins", "Docker package pins differ across versions.yml and the Linux bootstrap")

    package_version_match = re.search(
        r"docker_package_version\(\) \{(?P<body>.*?)(?=\n\})", bootstrap, re.DOTALL
    )
    package_version_body = package_version_match.group("body") if package_version_match else ""
    parsed_package = subprocess.run(
        ["awk", '$1 == "ii" { print $2; exit }'],
        input="ii  5:29.8.1-1~ubuntu.24.04~noble\n",
        capture_output=True,
        text=True,
        check=False,
    )
    if (
        package_version_match
        and '$1 == "ii" { print $2; exit }' in package_version_body
        and parsed_package.returncode == 0
        and parsed_package.stdout.strip() == expected_packages["docker-ce"]
    ):
        report("PASS", "cp4-dpkg-version-parser", "dpkg-query status padding is parsed without changing the pinned package version")
    else:
        report("FAIL", "cp4-dpkg-version-parser", "installed Docker package version parsing is missing or retains status padding")

    cp4_match = re.search(r"docker_checkpoint\(\) \{(?P<body>.*?)(?=\n\}\n\nwhile \[\[ \$# -gt 0 \]\])", bootstrap, re.DOTALL)
    check_match = re.search(r"docker_foundation_check\(\) \{(?P<body>.*?)(?=\n\}\n\ninstall_docker_firewall_integration\(\))", bootstrap, re.DOTALL)
    diagnostics_match = re.search(r"docker_app_diagnostics\(\) \{(?P<body>.*?)(?=\n\}\n\ndocker_foundation_check\(\))", bootstrap, re.DOTALL)
    cp4_body = cp4_match.group("body") if cp4_match else ""
    check_body = check_match.group("body") if check_match else ""
    diagnostics_body = diagnostics_match.group("body") if diagnostics_match else ""
    readonly_mutators = re.compile(
        r"\b(?:apt-get|install|mkdir|mv|rm|chmod|curl|systemctl\s+(?:enable|start|restart|stop)|iptables\s+[^\n]*(?:\s-I\s|\s-D\s|\s-N\s)|docker\s+compose\s+(?:up|down|rm|prune))\b"
    )
    readonly_ok = bool(check_match and diagnostics_match and not readonly_mutators.search(check_body + diagnostics_body))
    if readonly_ok:
        report("PASS", "cp4-check-readonly", "OS, package, runtime, network, volume, container, port and dependency probes are read-only")
    else:
        report("FAIL", "cp4-check-readonly", "CP4 Check is missing or contains a mutating command")
    if "report MISSING docker-ports 'ss is unavailable" in diagnostics_body:
        report("PASS", "cp4-check-ports", "Check fails when the listener probe is unavailable and reports each catalog port")
    else:
        report("FAIL", "cp4-check-ports", "Check can pass without a local port/listener probe")

    cp4_report_match = re.search(r"report\(\) \{(?P<body>.*?)(?=\n\})", bootstrap, re.DOTALL)
    cp4_dispatch_match = re.search(r"    4\)\n(?P<body>.*?)\n        ;;", bootstrap, re.DOTALL)
    cp4_check_failure_is_reported = bool(
        cp4_report_match
        and '"$1" == \'MISSING\'' in cp4_report_match.group("body")
        and '"$MODE" == \'check\'' in cp4_report_match.group("body")
        and '"$CHECKPOINT" == \'4\'' in cp4_report_match.group("body")
        and "CHECK_NEEDS_APPLY=1" in cp4_report_match.group("body")
        and cp4_dispatch_match
        and '"$MODE" == \'check\'' in cp4_dispatch_match.group("body")
        and "CHECK_NEEDS_APPLY" in cp4_dispatch_match.group("body")
    )
    if cp4_check_failure_is_reported:
        report("PASS", "cp4-check-exit", "any CP4 MISSING result makes read-only Check return nonzero")
    else:
        report("FAIL", "cp4-check-exit", "CP4 Check may report missing state while returning success")

    storage_match = re.search(r"docker_storage_check\(\) \{(?P<body>.*?)(?=\n\})", bootstrap, re.DOTALL)
    group_match = re.search(r"docker_group_check\(\) \{(?P<body>.*?)(?=\n\})", bootstrap, re.DOTALL)
    apply_missing_fails = all(
        match
        and '"$MODE" != \'apply\'' in match.group("body")
        and "return 1" in match.group("body")
        for match in (storage_match, group_match)
    )
    if apply_missing_fails:
        report("PASS", "cp4-apply-postchecks", "Apply stops on missing persistent Docker storage or unsafe Docker group state")
    else:
        report("FAIL", "cp4-apply-postchecks", "Apply can report PASS after a storage or Docker group postcheck failure")

    firewall_ok = all(
        token in bootstrap
        for token in (
            "DOCKER-USER",
            "-i wg-admin -s 10.99.0.0/24 -d 192.168.214.0/24",
            "-o wg-admin -s 192.168.214.0/24 -d 10.99.0.0/24",
            "Before=docker.service",
            "Requires=powerseven-admin-firewall.service powerseven-docker-firewall.service",
            "admin_firewall_is_ready",
            "docker_firewall_rules_are_first || return 1",
            "iptables -w -L FORWARD -v -n --line-numbers",
        )
    )
    if firewall_ok:
        report("PASS", "cp4-docker-firewall", "ordered DOCKER-USER rules preserve CP3 VPN-to-underlay forwarding before Docker starts")
    else:
        report("FAIL", "cp4-docker-firewall", "Docker firewall integration or CP2/CP3 preconditions are incomplete")

    conflict_match = re.search(r"local -a packages=\(([^)]*)\)", cp4_body)
    conflict_packages = set(re.findall(r"[A-Za-z0-9_.-]+", conflict_match.group(1))) if conflict_match else set()
    if {"docker-doc", "docker-buildx", "docker.io", "podman-docker", "containerd", "runc"}.issubset(conflict_packages):
        report("PASS", "cp4-package-conflicts", "officially conflicting distro Docker packages are detected and preserved")
    else:
        report("FAIL", "cp4-package-conflicts", "Apply may install over a conflicting distro Docker package")

    bootstrap_prereqs = re.search(r"require_commands apt-get dpkg-query(?P<body>.*?); then return 1; fi", cp4_body)
    prereq_install = cp4_body.find("apt-get install -y --no-install-recommends ca-certificates curl iptables")
    backend_probe = cp4_body.find("grep -q 'nf_tables'")
    if (
        bootstrap_prereqs
        and "iptables" not in bootstrap_prereqs.group(0)
        and "curl" not in bootstrap_prereqs.group(0)
        and prereq_install >= 0
        and backend_probe > prereq_install
        and "require_commands curl iptables" in cp4_body
    ):
        report("PASS", "cp4-prerequisite-order", "curl/iptables are installed before Apply checks the Docker firewall backend")
    else:
        report("FAIL", "cp4-prerequisite-order", "clean Ubuntu Apply requires a package before installing it")

    diagnostics_match = re.search(r"docker_app_diagnostics\(\) \{(?P<body>.*?)(?=\n\}\n\ndocker_foundation_check\(\))", bootstrap, re.DOTALL)
    diagnostics = diagnostics_match.group("body") if diagnostics_match else ""
    inventories = {
        "networks": {network.get("name", f"powerseven_{name}") for name, network in compose.get("networks", {}).items()},
        "volumes": {volume.get("name", f"powerseven_{name}") for name, volume in compose.get("volumes", {}).items()},
        "containers": {service.get("container_name", f"powerseven-{name}") for name, service in compose.get("services", {}).items()},
    }
    inventory_match = True
    for kind, expected in inventories.items():
        match = re.search(rf"local -a {kind}=\(([^)]*)\)", diagnostics)
        actual = set(re.findall(r"[A-Za-z0-9_.-]+", match.group(1))) if match else set()
        inventory_match = inventory_match and actual == expected
    expected_ports = set()
    for service in compose.get("services", {}).values():
        for port in service.get("ports", []):
            if isinstance(port, str):
                fields = port.split("/", 1)[0].split(":")
                if len(fields) >= 2:
                    expected_ports.add(fields[-2])
            elif isinstance(port, dict) and port.get("published"):
                expected_ports.add(str(port["published"]))
    port_match = re.search(r"for port in ([0-9 ]+); do", diagnostics)
    actual_ports = set(port_match.group(1).split()) if port_match else set()
    if inventory_match and actual_ports == expected_ports:
        report("PASS", "cp4-check-inventory", "network, volume, container and published-port diagnostics match Compose")
    else:
        report("FAIL", "cp4-check-inventory", "CP4 Check inventory or published-port list drifted from Compose")

    wrapper_match = re.search(r"\$wrapper = @'\n(?P<body>.*?)\n'@", runner, re.DOTALL)
    runner_stage_ok = (
        all(
            token in runner
            for token in (
                "docker\\compose.yml",
                "docker\\.env.example",
                "--runtime-token",
                "($dockerComposeSource",
                "($dockerEnvironmentTemplate",
                "CP4 runtime staging cleanup command",
            )
        )
        and wrapper_match is not None
        and "invalid CP4 runtime staging token" in wrapper_match.group("body")
    )
    if runner_stage_ok:
        report("PASS", "cp4-runner-stage", "DC02 stages only the tracked Compose catalog/template in a token-guarded remote directory")
    else:
        report("FAIL", "cp4-runner-stage", "CP4 runner payload staging or wrapper token allowlist is incomplete")

    if (
        "docker compose up" not in cp4_body
        and "docker compose down" not in cp4_body
        and "REQUIRED_DECISION" in (IAC / "docker" / ".env.example").read_text(encoding="utf-8")
        and "REQUIRED_SECRET" in (IAC / "docker" / ".env.example").read_text(encoding="utf-8")
    ):
        report("PASS", "cp4-application-gate", "no containers start while image decisions, secrets and host database/LDAP setup remain unresolved")
    else:
        report("FAIL", "cp4-application-gate", "CP4 could start an application stack with unresolved runtime inputs")

    docker = shutil.which("docker")
    if docker:
        result = subprocess.run(
            [docker, "compose", "-f", str(IAC / "docker" / "compose.yml"), "--env-file", str(IAC / "docker" / ".env.example"), "config", "--quiet"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            report("PASS", "cp4-compose-config", "tracked catalog parses with placeholders; no pull/start performed")
        else:
            report("FAIL", "cp4-compose-config", result.stderr.strip() or f"docker compose config exited {result.returncode}")
    else:
        report("WARN", "cp4-compose-config", "Docker CLI unavailable; the Compose runtime config check was not run")


def main() -> int:
    check_yaml_json()
    graph = json.loads(GRAPH.read_text(encoding="utf-8"))
    inventory_paths = sorted((IAC / "inventory").glob("*.yml"))
    inventories = [(path, load_yaml(path)) for path in inventory_paths]
    by_name = {path.name: data for path, data in inventories}
    check_graph_references(inventories, graph)
    check_ip_and_cidr(by_name["hosts.yml"], by_name["networks.yml"])
    check_secrets()
    check_user_provisioning_template()
    check_decisions()
    dependencies = load_yaml(IAC / "ansible" / "dependency-map.yml")
    check_dependency_cycles(dependencies)
    check_dns(by_name["dns.yml"])
    check_ports(by_name["services.yml"])
    check_vm_resources(load_yaml(IAC / "vmware" / "vm-definitions.yml"))
    check_vmware_definitions(load_yaml(IAC / "vmware" / "vm-definitions.yml"))
    check_scope_separation(inventories)
    check_compose()
    check_vps14_cp4()
    print(f"SUMMARY: PASS={PASS} WARN={WARN} FAIL={FAIL}")
