[Unit]
Description=PowerSeven profile: Stirling PDF
Requires=powerseven-core.target
After=powerseven-core.target powerseven-stop-all-optional.service
Conflicts=powerseven-profile-nextcloud.service powerseven-profile-forgejo.service powerseven-profile-pterodactyl.service powerseven-profile-wazuh.service powerseven-profile-scribble.service powerseven-stop-all-optional.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/powerseven-profile stirling start
ExecStartPost=/usr/local/libexec/powerseven-profile stirling health
ExecStop=/usr/local/libexec/powerseven-profile stirling stop
TimeoutStartSec=5min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
