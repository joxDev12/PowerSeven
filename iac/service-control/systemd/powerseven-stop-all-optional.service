[Unit]
Description=PowerSeven kill switch: stop all optional profiles
Conflicts=powerseven-profile-pterodactyl.service powerseven-profile-wazuh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/powerseven-profile all-off start
TimeoutStartSec=5min

[Install]
WantedBy=powerseven-core.target
