polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("powerseven-operators"))
        return polkit.Result.NOT_HANDLED;

    var allowed = [
        "powerseven-profile-nextcloud.service",
        "powerseven-profile-forgejo.service",
        "powerseven-profile-stirling.service",
        "powerseven-profile-pterodactyl.service",
        "powerseven-profile-wazuh.service",
        "powerseven-profile-scribble.service",
        "powerseven-stop-all-optional.service"
    ];
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var verbs = ["start", "stop", "restart"];

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        allowed.indexOf(unit) >= 0 && verbs.indexOf(verb) >= 0)
        return polkit.Result.YES;

    return polkit.Result.NOT_HANDLED;
});
